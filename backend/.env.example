# Backend environment example
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Groq intelligence (optional). Without a key the dashboard uses the built-in analytics engine.
# Create a key at https://console.groq.com/keys and paste it into backend/.env (never commit it).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Dataset in backend/uploads/ to load automatically on startup (optional)
DEFAULT_DATASET=test_supply_chain.csv
